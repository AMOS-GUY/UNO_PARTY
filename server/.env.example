# Port the server listens on (default 3001)
PORT=3001

# CORS origin for Socket.IO (default "*"). Set to your client origin in production,
# e.g. CLIENT_ORIGIN=https://uno.example.com
CLIENT_ORIGIN=*

# TLS: when BOTH are set the server serves HTTPS + WSS; otherwise plain HTTP + WS
# for local dev. In production a TLS-terminating reverse proxy (Caddy/nginx)
# is recommended instead.
# TLS_KEY_PATH=/path/to/privkey.pem
# TLS_CERT_PATH=/path/to/fullchain.pem

# Directory of the built client to serve statically (single-port production
# mode). Defaults to ../client/dist; served only when index.html exists there.
# CLIENT_DIST=/app/client/dist
